{
  "name": "efureev/laravel-support-db",
  "description": "PostgreSQL features for Laravel's schema and query builders: partial indexes, views, CREATE TABLE LIKE, extensions, RETURNING, and PostgreSQL-only column types",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "php",
    "laravel",
    "postgres",
    "postgresql",
    "pgsql",
    "database",
    "schema",
    "migrations",
    "partial-index",
    "materialized-view",
    "returning",
    "db"
  ],
  "authors": [
    {
      "name": "Eugene Fureev",
      "homepage": "https://github.com/efureev"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-pdo": "*",
    "illuminate/database": "^13.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.52",
    "larastan/larastan": "^3.12",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.0",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "autoload": {
    "psr-4": {
      "Php\\Support\\Laravel\\Database\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Php\\Support\\Laravel\\Database\\Tests\\": "tests/",
      "Php\\Support\\Laravel\\Database\\Tests\\Database\\Factories\\": "tests/database/factories"
    }
  },
  "archive": {
    "exclude": [
      "/.docker",
      "/.dockerignore",
      "/.github",
      "/.gitignore",
      "/.phpcs.xml",
      "/CHANGELOG.md",
      "/docker-compose.yml",
      "/docs",
      "/phpstan.neon",
      "/phpunit.xml.dist",
      "/tests",
      "/tools"
    ]
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true
    },
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Php\\Support\\Laravel\\Database\\ServiceProvider"
      ]
    }
  },
  "scripts": {
    "cs-fix": "@php ./vendor/bin/phpcbf",
    "phpcs": "@php ./vendor/bin/phpcs",
    "phpstan": "@php ./vendor/bin/phpstan analyze -c phpstan.neon --no-progress --ansi",
    "phpunit": "@php ./vendor/bin/phpunit --no-coverage --testdox --colors=always",
    "phpunit-cover": "@php ./vendor/bin/phpunit --coverage-clover ./storage/coverage/clover.xml",
    "phpunit-unit": "@php ./vendor/bin/phpunit --no-coverage --testdox --colors=always --testsuite=Unit",
    "test": [
      "@phpcs",
      "@phpunit"
    ],
    "test-cover": [
      "@phpcs",
      "@phpunit-cover"
    ],
    "test:docker": "docker compose up --build --abort-on-container-exit --exit-code-from app"
  }
}
